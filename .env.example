# --- Database (Supabase Postgres) ---
# For `prisma migrate` use the DIRECT connection (port 5432):
#   Supabase dashboard → Project Settings → Database → Connection string → Direct
#   e.g. postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# For the running app on Vercel (serverless) prefer the POOLED string (port 6543)
# with ?pgbouncer=true appended — same value works in this field.
DATABASE_URL="postgresql://user:pass@host:5432/roobet_tracker?schema=public"
BOOKMARKLET_API_KEY="generate-a-long-random-string"
BASIC_USER="youruser"
BASIC_PASS="a-strong-password"
